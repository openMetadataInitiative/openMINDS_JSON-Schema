{
  "$id": "https://openminds.om-i.org/types/CustomAnatomicalEntity?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/CustomAnatomicalEntity",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/hasAnnotation": {
          "description": null,
          "items": {
            "$ref": "https://openminds.om-i.org/types/CustomAnnotation?format=json-schema#/definitions/embedded",
            "type": "object"
          },
          "minItems": 1,
          "name": "hasAnnotation",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        },
        "https://openminds.om-i.org/props/relatedUBERONTerm": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "format": "uuid"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "relatedUBERONTerm",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "format": "uuid"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/Organ",
                  "https://openminds.om-i.org/types/UBERONParcellation"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/relationAssessment": {
          "description": null,
          "items": {
            "anyOf": [
              {
                "$ref": "https://openminds.om-i.org/types/QualitativeRelationAssessment?format=json-schema#/definitions/embedded",
                "type": "object"
              },
              {
                "$ref": "https://openminds.om-i.org/types/QuantitativeRelationAssessment?format=json-schema#/definitions/embedded",
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "name": "relationAssessment",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/name"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "CustomAnatomicalEntity",
  "type": "object"
}