{
  "$id": "https://openminds.om-i.org/types/ParcellationEntityVersion?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/ParcellationEntityVersion",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/abbreviation": {
          "name": "abbreviation",
          "type": "string"
        },
        "https://openminds.om-i.org/props/additionalRemarks": {
          "description": "Mention of what deserves additional attention or notice.",
          "name": "additionalRemarks",
          "type": "string"
        },
        "https://openminds.om-i.org/props/alternateName": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "name": "alternateName",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/correctedName": {
          "name": "correctedName",
          "type": "string"
        },
        "https://openminds.om-i.org/props/hasAnnotation": {
          "items": {
            "$ref": "https://openminds.om-i.org/types/AtlasAnnotation?format=json-schema#/definitions/embedded",
            "type": "object"
          },
          "minItems": 1,
          "name": "hasAnnotation",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/hasParent": {
          "description": "Reference to a parent object or legal person.",
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.om-i.org/types/ParcellationEntity",
                    "https://openminds.om-i.org/types/ParcellationEntityVersion"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "hasParent",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/lookupLabel": {
          "name": "lookupLabel",
          "type": "string"
        },
        "https://openminds.om-i.org/props/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        },
        "https://openminds.om-i.org/props/ontologyIdentifier": {
          "description": "Term or code used to identify something or someone registered within a particular ontology.",
          "items": {
            "format": "iri",
            "type": "string"
          },
          "minItems": 1,
          "name": "ontologyIdentifier",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/relationAssessment": {
          "items": {
            "anyOf": [
              {
                "$ref": "https://openminds.om-i.org/types/QualitativeRelationAssessment?format=json-schema#/definitions/embedded",
                "type": "object"
              },
              {
                "$ref": "https://openminds.om-i.org/types/QuantitativeRelationAssessment?format=json-schema#/definitions/embedded",
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "name": "relationAssessment",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/versionIdentifier": {
          "description": "Term or code used to identify the version of something.",
          "name": "versionIdentifier",
          "type": "string"
        },
        "https://openminds.om-i.org/props/versionInnovation": {
          "description": "Documentation on what changed in comparison to a previously published form of something.",
          "name": "versionInnovation",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/name",
        "https://openminds.om-i.org/props/versionIdentifier"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "ParcellationEntityVersion",
  "type": "object"
}