{
  "$id": "https://openminds.om-i.org/types/CoordinatePoint?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/CoordinatePoint",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/coordinateSpace": {
          "description": "Two or three dimensional geometric setting.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "coordinateSpace",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/CommonCoordinateSpaceVersion",
                  "https://openminds.om-i.org/types/CustomCoordinateSpace"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/coordinates": {
          "description": "Pair or triplet of numbers defining a location in a given coordinate space.",
          "items": {
            "$ref": "https://openminds.om-i.org/types/QuantitativeValue?format=json-schema#/definitions/embedded",
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 2,
          "name": "coordinates",
          "type": "array"
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/coordinateSpace",
        "https://openminds.om-i.org/props/coordinates"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "CoordinatePoint",
  "type": "object"
}