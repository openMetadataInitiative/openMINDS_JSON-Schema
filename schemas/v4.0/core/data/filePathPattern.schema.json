{
  "$id": "https://openminds.om-i.org/types/FilePathPattern?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/FilePathPattern",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/groupingType": {
          "description": null,
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.om-i.org/types/FileBundleGrouping"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "groupingType",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/regex": {
          "description": null,
          "format": "ECMA262",
          "name": "regex",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/groupingType",
        "https://openminds.om-i.org/props/regex"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "FilePathPattern",
  "type": "object"
}