{
  "$id": "https://openminds.om-i.org/types/ProductSource?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/ProductSource",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/digitalIdentifier": {
          "description": "Digital handle to identify objects or legal persons.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "digitalIdentifier",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/RRID"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/identifier": {
          "description": "Term or code used to identify something or someone.",
          "name": "identifier",
          "type": "string"
        },
        "https://openminds.om-i.org/props/productName": {
          "name": "productName",
          "type": "string"
        },
        "https://openminds.om-i.org/props/provider": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "provider",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/Consortium",
                  "https://openminds.om-i.org/types/Organization",
                  "https://openminds.om-i.org/types/Person"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/purity": {
          "anyOf": [
            {
              "$ref": "https://openminds.om-i.org/types/QuantitativeValue?format=json-schema#/definitions/embedded",
              "type": "object"
            },
            {
              "$ref": "https://openminds.om-i.org/types/QuantitativeValueRange?format=json-schema#/definitions/embedded",
              "type": "object"
            }
          ],
          "name": "purity"
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/productName",
        "https://openminds.om-i.org/props/provider"
      ],
      "type": "object"
    }
  },
  "description": "Structured information about the source of a chemical substance or mixture.",
  "required": [
    "@id"
  ],
  "title": "ProductSource",
  "type": "object"
}