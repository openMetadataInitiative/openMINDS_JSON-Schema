{
  "$id": "https://openminds.ebrains.eu/sands/CustomAnatomicalEntity?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/sands/CustomAnatomicalEntity",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/hasAnnotation": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "hasAnnotation",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/sands/CustomAnnotation"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/relationAssessment": {
          "description": null,
          "items": {
            "anyOf": [
              {
                "$ref": "https://openminds.ebrains.eu/sands/QualitativeRelationAssessment?format=json-schema#/definitions/embedded",
                "type": "object"
              },
              {
                "$ref": "https://openminds.ebrains.eu/sands/QuantitativeRelationAssessment?format=json-schema#/definitions/embedded",
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "name": "relationAssessment",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/name"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "CustomAnatomicalEntity",
  "type": "object"
}