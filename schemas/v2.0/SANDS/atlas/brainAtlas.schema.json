{
  "$id": "https://openminds.ebrains.eu/sands/BrainAtlas?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/sands/BrainAtlas",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/description": {
          "description": "Longer statement or account giving the characteristics of someone or something.",
          "name": "description",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/digitalIdentifier": {
          "description": "Digital handle to identify objects or legal persons.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "digitalIdentifier",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/DOI"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/fullName": {
          "description": "Whole, non-abbreviated name of something or somebody.",
          "name": "fullName",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/hasVersion": {
          "description": "Reference to variants of an original.",
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.ebrains.eu/sands/BrainAtlasVersion"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "hasVersion",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.ebrains.eu/vocab/homepage": {
          "description": "Main website of something or someone.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "homepage",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/URL"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/howToCite": {
          "description": "Preferred format for citing a particular object or legal person.",
          "name": "howToCite",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/shortName": {
          "description": "Shortened or fully abbreviated name of something or somebody.",
          "name": "shortName",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/description",
        "https://openminds.ebrains.eu/vocab/fullName",
        "https://openminds.ebrains.eu/vocab/hasVersion",
        "https://openminds.ebrains.eu/vocab/shortName"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "BrainAtlas",
  "type": "object"
}