{
  "$id": "https://openminds.om-i.org/types/GridImageSequence?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/GridImageSequence",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/additionalRemarks": {
          "description": "Mention of what deserves additional attention or notice.",
          "name": "additionalRemarks",
          "type": "string"
        },
        "https://openminds.om-i.org/props/coordinateFramework": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "coordinateFramework",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion",
                  "https://openminds.om-i.org/types/CustomCoordinateFramework"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/dataLocation": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "dataLocation",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/File",
                  "https://openminds.om-i.org/types/FileBundle"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/dimension": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "name": "dimension",
          "type": "array"
        },
        "https://openminds.om-i.org/props/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        },
        "https://openminds.om-i.org/props/numberOfImages": {
          "minimum": 2,
          "name": "numberOfImages",
          "type": "integer"
        },
        "https://openminds.om-i.org/props/obtainedWith": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "obtainedWith",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/ElectrodeArrayUsage",
                  "https://openminds.om-i.org/types/ElectrodeUsage",
                  "https://openminds.om-i.org/types/PipetteUsage",
                  "https://openminds.om-i.org/types/MRICoilUsage",
                  "https://openminds.om-i.org/types/MRIScannerUsage",
                  "https://openminds.om-i.org/types/SlicingDeviceUsage"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/pixelSize": {
          "items": {
            "$ref": "https://openminds.om-i.org/types/QuantitativeValue?format=json-schema#/definitions/embedded",
            "type": "object"
          },
          "maxItems": 2,
          "minItems": 2,
          "name": "pixelSize",
          "type": "array"
        },
        "https://openminds.om-i.org/props/temporalSamplingFrequency": {
          "$ref": "https://openminds.om-i.org/types/QuantitativeValue?format=json-schema#/definitions/embedded",
          "name": "temporalSamplingFrequency",
          "type": "object"
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/dataLocation",
        "https://openminds.om-i.org/props/dimension",
        "https://openminds.om-i.org/props/pixelSize",
        "https://openminds.om-i.org/props/temporalSamplingFrequency"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "GridImageSequence",
  "type": "object"
}