{
  "$id": "https://openminds.ebrains.eu/core/TissueSampleState?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/core/TissueSampleState",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/additionalRemarks": {
          "description": "Mention of what deserves additional attention or notice.",
          "name": "additionalRemarks",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/age": {
          "anyOf": [
            {
              "$ref": "https://openminds.ebrains.eu/core/QuantitativeValue?format=json-schema#/definitions/embedded",
              "type": "object"
            },
            {
              "$ref": "https://openminds.ebrains.eu/core/QuantitativeValueRange?format=json-schema#/definitions/embedded",
              "type": "object"
            }
          ],
          "description": "Time of life or existence at which some particular qualification, capacity or event arises.",
          "name": "age"
        },
        "https://openminds.ebrains.eu/vocab/lookupLabel": {
          "description": null,
          "name": "lookupLabel",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/pathology": {
          "description": "Structural and functional deviation from the normal that constitutes a disease or characterizes a particular disease.",
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.ebrains.eu/controlledTerms/Disease",
                    "https://openminds.ebrains.eu/controlledTerms/DiseaseModel"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "pathology",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.ebrains.eu/vocab/weight": {
          "anyOf": [
            {
              "$ref": "https://openminds.ebrains.eu/core/QuantitativeValue?format=json-schema#/definitions/embedded",
              "type": "object"
            },
            {
              "$ref": "https://openminds.ebrains.eu/core/QuantitativeValueRange?format=json-schema#/definitions/embedded",
              "type": "object"
            }
          ],
          "description": "Amount that a thing or being weighs.",
          "name": "weight"
        }
      },
      "required": [
        "@type"
      ],
      "type": "object"
    }
  },
  "description": "Structured information on a temporary state of a tissue sample.",
  "required": [
    "@id"
  ],
  "title": "TissueSampleState",
  "type": "object"
}