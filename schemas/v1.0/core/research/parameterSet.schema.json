{
  "$id": "https://openminds.ebrains.eu/core/ParameterSet?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/core/ParameterSet",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/context": {
          "name": "context",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/parameter": {
          "description": "Digital or physical property determining a particular function, characteristic or behavior of something.",
          "items": {
            "anyOf": [
              {
                "$ref": "https://openminds.ebrains.eu/core/NumericalParameter?format=json-schema#/definitions/embedded",
                "type": "object"
              },
              {
                "$ref": "https://openminds.ebrains.eu/core/StringParameter?format=json-schema#/definitions/embedded",
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "name": "parameter",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.ebrains.eu/vocab/relevantFor": {
          "description": "Reference to what or whom something or someone bears significance.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "relevantFor",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/BehavioralTask",
                  "https://openminds.ebrains.eu/controlledTerms/Technique"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/context",
        "https://openminds.ebrains.eu/vocab/parameter",
        "https://openminds.ebrains.eu/vocab/relevantFor"
      ],
      "type": "object"
    }
  },
  "description": "Structured information on a used parameter set.",
  "required": [
    "@id"
  ],
  "title": "ParameterSet",
  "type": "object"
}