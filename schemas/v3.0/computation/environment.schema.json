{
  "$id": "https://openminds.ebrains.eu/computation/Environment?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/computation/Environment",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/configuration": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "configuration",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/Configuration"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/description": {
          "description": "Longer statement or account giving the characteristics of someone or something.",
          "name": "description",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/hardware": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "hardware",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/computation/HardwareSystem"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/software": {
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.ebrains.eu/core/SoftwareVersion"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "software",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/hardware",
        "https://openminds.ebrains.eu/vocab/name"
      ],
      "type": "object"
    }
  },
  "description": "Structured information on the computer system or set of systems in which a computation is deployed and executed.",
  "required": [
    "@id"
  ],
  "title": "Environment",
  "type": "object"
}