                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/computation/WorkflowRecipeVersion"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/stage": {
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "format": "iri"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
