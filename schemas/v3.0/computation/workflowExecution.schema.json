                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/recipe": {
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
