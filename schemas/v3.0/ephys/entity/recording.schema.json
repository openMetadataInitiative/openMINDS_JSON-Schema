{
  "$id": "https://openminds.ebrains.eu/ephys/Recording?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/ephys/Recording",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/additionalRemarks": {
          "description": "Mention of what deserves additional attention or notice.",
          "name": "additionalRemarks",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/channel": {
          "description": null,
          "items": {
            "$ref": "https://openminds.ebrains.eu/ephys/Channel?format=json-schema#/definitions/embedded",
            "type": "object"
          },
          "minItems": 1,
          "name": "channel",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.ebrains.eu/vocab/dataLocation": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "dataLocation",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/File",
                  "https://openminds.ebrains.eu/core/FileBundle"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/internalIdentifier": {
          "description": "Term or code that identifies someone or something within a particular product.",
          "name": "internalIdentifier",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/previousRecording": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "previousRecording",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/ephys/Recording"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/recordedWith": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "recordedWith",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/ephys/ElectrodeArrayUsage",
                  "https://openminds.ebrains.eu/ephys/ElectrodeUsage",
                  "https://openminds.ebrains.eu/ephys/PipetteUsage",
                  "https://openminds.ebrains.eu/specimenPrep/SlicingDeviceUsage"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/samplingFrequency": {
          "$ref": "https://openminds.ebrains.eu/core/QuantitativeValue?format=json-schema#/definitions/embedded",
          "description": null,
          "name": "samplingFrequency",
          "type": "object"
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/channel",
        "https://openminds.ebrains.eu/vocab/dataLocation",
        "https://openminds.ebrains.eu/vocab/recordedWith",
        "https://openminds.ebrains.eu/vocab/samplingFrequency"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "Recording",
  "type": "object"
}