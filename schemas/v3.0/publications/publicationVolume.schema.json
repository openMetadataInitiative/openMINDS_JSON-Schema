{
  "$id": "https://openminds.ebrains.eu/publications/PublicationVolume?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/publications/PublicationVolume",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/isPartOf": {
          "description": "Reference to the ensemble of multiple things or beings.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "isPartOf",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/publications/Periodical"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/volumeNumber": {
          "name": "volumeNumber",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/isPartOf",
        "https://openminds.ebrains.eu/vocab/volumeNumber"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "PublicationVolume",
  "type": "object"
}