{
  "$id": "https://openminds.ebrains.eu/publications/Periodical?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/publications/Periodical",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/abbreviation": {
          "name": "abbreviation",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/digitalIdentifier": {
          "description": "Digital handle to identify objects or legal persons.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "digitalIdentifier",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/ISSN"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/name": {
          "description": "Word or phrase that constitutes the distinctive designation of a being or thing.",
          "name": "name",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/name"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "Periodical",
  "type": "object"
}