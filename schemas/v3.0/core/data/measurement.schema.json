{
  "$id": "https://openminds.ebrains.eu/core/Measurement?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/core/Measurement",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/additionalRemarks": {
          "description": "Mention of what deserves additional attention or notice.",
          "name": "additionalRemarks",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/measuredQuantity": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "measuredQuantity",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/controlledTerms/MeasuredQuantity"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/measuredWith": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "measuredWith",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/ephys/ElectrodeArrayUsage",
                  "https://openminds.ebrains.eu/ephys/ElectrodeUsage",
                  "https://openminds.ebrains.eu/ephys/PipetteUsage",
                  "https://openminds.ebrains.eu/specimenPrep/SlicingDeviceUsage"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/timestamp": {
          "description": null,
          "format": "date-time",
          "name": "timestamp",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/value": {
          "description": "Entry for a property.",
          "items": {
            "anyOf": [
              {
                "$ref": "https://openminds.ebrains.eu/core/QuantitativeValue?format=json-schema#/definitions/embedded",
                "type": "object"
              },
              {
                "$ref": "https://openminds.ebrains.eu/core/QuantitativeValueRange?format=json-schema#/definitions/embedded",
                "type": "object"
              }
            ]
          },
          "minItems": 1,
          "name": "value",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/measuredQuantity",
        "https://openminds.ebrains.eu/vocab/value"
      ],
      "type": "object"
    }
  },
  "description": "Structured information about a measurement performed during a scientific experiment.",
  "required": [
    "@id"
  ],
  "title": "Measurement",
  "type": "object"
}