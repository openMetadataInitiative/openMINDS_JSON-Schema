{
  "$id": "https://openminds.ebrains.eu/core/Configuration?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.ebrains.eu/core/Configuration",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/configuration": {
          "name": "configuration",
          "type": "string"
        },
        "https://openminds.ebrains.eu/vocab/format": {
          "description": "Method of digitally organizing and structuring data or information.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "format",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "format": "iri"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.ebrains.eu/core/ContentType"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.ebrains.eu/vocab/lookupLabel": {
          "name": "lookupLabel",
          "type": "string"
        }
      },
      "required": [
        "@type",
        "https://openminds.ebrains.eu/vocab/configuration",
        "https://openminds.ebrains.eu/vocab/format"
      ],
      "type": "object"
    }
  },
  "description": "Structured information about the properties or parameters of an entity or process.",
  "required": [
    "@id"
  ],
  "title": "Configuration",
  "type": "object"
}