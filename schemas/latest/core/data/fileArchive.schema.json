{
  "$id": "https://openminds.om-i.org/types/FileArchive?format=json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "#/definitions/embedded"
    }
  ],
  "definitions": {
    "embedded": {
      "properties": {
        "@id": {
          "description": "Metadata node identifier.",
          "type": "string"
        },
        "@type": {
          "const": "https://openminds.om-i.org/types/FileArchive",
          "description": "Metadata schema identifier.",
          "type": "string"
        },
        "https://openminds.om-i.org/props/IRI": {
          "description": "Stands for Internationalized Resource Identifier which is an internet protocol standard that builds on the URI protocol, extending the set of permitted characters to include Unicode/ISO 10646.",
          "format": "iri",
          "name": "IRI",
          "type": "string"
        },
        "https://openminds.om-i.org/props/format": {
          "description": "Method of digitally organizing and structuring data or information.",
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "if": {
            "required": [
              "@type"
            ]
          },
          "name": "format",
          "then": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  }
                ],
                "type": "string"
              },
              "@type": {
                "enum": [
                  "https://openminds.om-i.org/types/ContentType"
                ],
                "format": "iri",
                "type": "string"
              }
            },
            "required": [
              "@id"
            ]
          },
          "type": "object"
        },
        "https://openminds.om-i.org/props/sourceData": {
          "description": null,
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.om-i.org/types/File"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "sourceData",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "@type",
        "https://openminds.om-i.org/props/IRI",
        "https://openminds.om-i.org/props/format"
      ],
      "type": "object"
    }
  },
  "required": [
    "@id"
  ],
  "title": "FileArchive",
  "type": "object"
}