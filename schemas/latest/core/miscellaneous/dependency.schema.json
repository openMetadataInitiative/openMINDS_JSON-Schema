        "https://openminds.om-i.org/props/failureImpact": {
          "description": null,
          "items": {
            "else": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "if": {
              "required": [
                "@type"
              ]
            },
            "then": {
              "properties": {
                "@id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                    },
                    {
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  ],
                  "type": "string"
                },
                "@type": {
                  "enum": [
                    "https://openminds.om-i.org/types/DependencyImpact"
                  ],
                  "format": "iri",
                  "type": "string"
                }
              },
              "required": [
                "@id"
              ]
            },
            "type": "object"
          },
          "minItems": 1,
          "name": "failureImpact",
          "type": "array",
          "uniqueItems": true
        },
        "https://openminds.om-i.org/props/fulfilledBy": {
          "description": null,
          "else": {
            "properties": {
              "@id": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*:\\S+$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
